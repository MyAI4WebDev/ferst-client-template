# build output
dist/
.astro/

# dependencies
node_modules/

# local core validation tarball (npm pack of ferst-core)
*.tgz

# logs
npm-debug.log*

# environment
.env
.env.local
.env.*.local

# macOS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# Content authored in production by editors via /admin (committed by the platform
# git-proxy straight to the configured branch). Local dev edits must not pollute.
src/content/posts/
public/uploads/

# migrate-site skill workspace (a snapshot of the old site) — temporary, never committed
.migration/

# wrangler's local state (`npx wrangler pages dev dist`: the redirect check's local copy)
.wrangler/
